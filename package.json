{
  "name": "telegram-community-migrator-pro",
  "version": "1.0.0",
  "description": "Consent-based Telegram community migration desktop software",
  "main": "src/main.js",
  "author": "Telegram Community Migrator Pro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tcmpro.desktop",
    "productName": "Telegram Community Migrator Pro",
    "asar": true,
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "TelegramCommunityMigratorPro_Setup.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telegram Community Migrator Pro",
      "uninstallDisplayName": "Telegram Community Migrator Pro"
    }
  }
}
